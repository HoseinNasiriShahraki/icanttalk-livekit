{
  "name": "icanttalk",
  "version": "1.1.1",
  "private": true,
  "description": "Cross-platform LiveKit voice, webcam and multi-stream screen-sharing client.",
  "author": "iCANTTalk",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --x64",
    "dist:portable": "npm run build:renderer && electron-builder --win portable --x64"
  },
  "dependencies": {
    "livekit-client": "2.21.0",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.1.1",
    "@livekit/krisp-noise-filter": "0.4.4"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.6.0",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.0.12",
    "typescript": "5.8.3",
    "vite": "7.0.4",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "com.icanttalk.desktop",
    "productName": "iCANTTalk",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "iCANTTalk-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "iCANTTalk",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "iCANTTalk-Portable-${version}-${arch}.${ext}"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/icanttalk.git",
    "directory": "windows"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/icanttalk/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/icanttalk#readme"
}
