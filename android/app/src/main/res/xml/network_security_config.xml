<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is enabled only because the currently supplied Django endpoint is HTTP.
         Replace the endpoint with HTTPS and set this to false before public distribution. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
